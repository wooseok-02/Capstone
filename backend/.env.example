DATABASE_URL=postgresql://pet:local-dev-password@127.0.0.1:5432/knowledge_pet
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8000/auth/naver/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback
JWT_SECRET=

# Cloudflare R2 (비공개 버킷). 비워 두면 문서 업로드·다운로드 API가 503을 반환한다.
R2_ENDPOINT_URL=https://<계정ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 임시 기본값(초·byte). 팀 확정 후 조정한다.
UPLOAD_URL_EXPIRES=1800
DOWNLOAD_URL_EXPIRES=1800
AI_DOWNLOAD_URL_EXPIRES=600
MAX_UPLOAD_BYTES=104857600

# AI 서버. 비워 두면 업로드는 uploaded에서 멈추고 검색은 503을 반환한다.
AI_PROCESS_URL=
AI_EMBED_URL=
AI_INTERNAL_TOKEN=
AI_TIMEOUT_SECONDS=300
